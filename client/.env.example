# ==============================================================================
# ProxiPilot Client Environment Variables
# ==============================================================================
# IMPORTANT:
# - Variables prefixed with `NEXT_PUBLIC_` are exposed to the browser client bundle.
# - DO NOT put private secrets, private keys, database credentials, or backend service tokens
#   in NEXT_PUBLIC_* variables.
# - Server-only variables (without NEXT_PUBLIC_) are accessible ONLY during server-side execution.
# ==============================================================================

# Client-Safe Public Variables
NEXT_PUBLIC_APP_NAME="ProxiPilot"
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
NEXT_PUBLIC_API_TIMEOUT_MS="15000"

# Feature Flags (Client-Safe)
NEXT_PUBLIC_ENABLE_ANALYTICS="false"
NEXT_PUBLIC_ENABLE_MOCK_API="false"

# Server-Only Variables (Accessible ONLY in Server Components / Route Handlers)
# INTERNAL_API_SECRET=
# ENCRYPTION_KEY=

{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node -e \"try { fs.rmSync('.next/dev', { recursive: true, force: true }); fs.rmSync('.next/server', { recursive: true, force: true }); } catch (e) {}\"",
    "build": "node -e \"try { fs.rmSync('.next/dev', { recursive: true, force: true }); fs.rmSync('.next/server', { recursive: true, force: true }); } catch (e) {}\" && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.9.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/material-nextjs": "^9.4.0",
    "@tabler/icons-react": "^3.48.0",
    "@tanstack/react-query": "^5.103.0",
    "clsx": "^2.1.1",
    "motion": "^14.0.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "sass": "^1.104.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.9.7",
    "typescript": "^5"
  }
}

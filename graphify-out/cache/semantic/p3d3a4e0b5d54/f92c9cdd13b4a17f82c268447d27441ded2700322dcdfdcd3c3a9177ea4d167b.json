{"nodes": [{"id": "docs_adr_adr_013_role_permission_model", "label": "ADR-013: Extensible Role-Permission RBAC Model", "file_type": "document", "source_file": "docs/adr/ADR-013-role-permission-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_adr_013_role_permission_model_three_table_rbac_model", "label": "Three-Table RBAC Model", "file_type": "rationale", "source_file": "docs/adr/ADR-013-role-permission-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hardcoded role checks create fragile code, duplicated security rules, and block custom enterprise roles; roles/permissions/role_permissions allow fine-grained permissions without schema changes."}, {"id": "docs_adr_adr_013_role_permission_model_authorizationservice", "label": "AuthorizationService", "file_type": "rationale", "source_file": "docs/adr/ADR-013-role-permission-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All authorization flows through a central service evaluating permission keys, with zero hardcoded role checks in route handlers."}, {"id": "docs_adr_adr_013_role_permission_model_system_roles_owner_admin_member", "label": "System Roles OWNER ADMIN MEMBER", "file_type": "rationale", "source_file": "docs/adr/ADR-013-role-permission-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "is_system_role=True with organization_id NULL; tenant custom roles populate organization_id."}, {"id": "docs_adr_adr_013_role_permission_model_permission_keys", "label": "Permission Keys", "file_type": "rationale", "source_file": "docs/adr/ADR-013-role-permission-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Discrete keys like organiz
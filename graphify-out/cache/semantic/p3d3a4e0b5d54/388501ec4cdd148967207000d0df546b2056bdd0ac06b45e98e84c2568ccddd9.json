{"nodes": [{"id": "server_docs_email_pipeline_latency_root_cause_and_remediation_report_email_pipeline_latency_root_cause_and_remediation_report", "label": "Email Pipeline Latency Root-Cause and Remediation Report", "file_type": "document", "source_file": "server/docs/EMAIL-PIPELINE-LATENCY-ROOT-CAUSE-AND-REMEDIATION-REPORT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "server_docs_email_pipeline_latency_root_cause_and_remediation_report_reply_planning_latency_bottleneck", "label": "Reply Planning Latency Bottleneck", "file_type": "rationale", "source_file": "server/docs/EMAIL-PIPELINE-LATENCY-ROOT-CAUSE-AND-REMEDIATION-REPORT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "gpt-5-mini generated ~2,293 completion tokens due to prompt verbosity; capping max_completion_tokens at 2500 and concise prompts cut drafter latency 37.26s -> 12.24s."}, {"id": "server_docs_email_pipeline_latency_root_cause_and_remediation_report_leaked_internal_fact_signal_ids_defect", "label": "Leaked Internal Fact/Signal IDs Defect", "file_type": "rationale", "source_file": "server/docs/EMAIL-PIPELINE-LATENCY-ROOT-CAUSE-AND-REMEDIATION-REPORT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spurious sub_category attribute in planner fast path created MissingInformationSignal quoted verbatim; fixed by removing attribute, negative prompt constraints, and regex sanitizer in validator.py."}, {"id": "server_docs_email_pipeline_latency_root_cause_and_remediation_report_redis_pel_auto_claim_min_idle_time_fix", "label": "Redis PEL Auto-Claim min_idle_time Fix", "file_type": "rationale", "source_file": "server/docs/EMAIL-PIPELINE-LATENCY-ROOT-CAUSE-AND-REMEDIATION-REPORT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale":
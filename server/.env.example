# ==============================================================================
# ProxiPilot Enterprise Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development.
# In production, inject variables using a cloud Secret Manager (AWS/Azure/GCP/Vault).
# ==============================================================================

# Application & Environment
APP_NAME="ProxiPilot Backend"
ENVIRONMENT=development    # development | staging | production | test
DEBUG=false
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000"]

# Database (PostgreSQL / Neon Serverless)
DATABASE_URL=postgresql://user:password@localhost:5432/proxipilot_dev
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=300

# Redis Cache & Streams (Upstash / Standalone Redis)
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT_SECONDS=5

# Qdrant Vector Search
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=10

# Authentication & Security
JWT_SECRET_KEY=replace-with-secure-random-64-character-hex-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=259200
JWT_REFRESH_TOKEN_EXPIRE_DAYS=180

# Email Integration Providers
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
MICROSOFT_CLIENT_ID=your-microsoft-app-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=your-microsoft-tenant-id

# AI & LLM Services (OpenAI)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=3

# Background Workers & Concurrency
AI_WORKER_CONCURRENCY=4
EMAIL_WORKER_CONCURRENCY=8
AUTOMATION_WORKER_CONCURRENCY=4
EVENT_BUS_STREAM_PREFIX=proxipilot:stream:

# Observability
LOG_LEVEL=INFO
LOG_FORMAT_JSON=true
ENABLE_METRICS=true

# ── System email (verification & password-reset codes) ─────────────────────────
# log  = send nothing, only log (local development). Production MUST use smtp,
#        otherwise users never receive signup or password-reset codes.
EMAIL_DELIVERY=log
# Any SMTP provider works. Examples:
#   AWS SES (ap-south-1, same region as the EC2 server):  SMTP_HOST=email-smtp.ap-south-1.amazonaws.com  SMTP_PORT=587  SMTP_SECURITY=starttls
#   Resend:               SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_SECURITY=ssl  SMTP_USERNAME=resend
#   Postmark:             SMTP_HOST=smtp.postmarkapp.com  SMTP_PORT=587  SMTP_SECURITY=starttls
#   Twilio SendGrid:      SMTP_HOST=smtp.sendgrid.net  SMTP_PORT=587  SMTP_SECURITY=starttls  SMTP_USERNAME=apikey  SMTP_PASSWORD=<SG. API key with Mail Send>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=no-reply@proxipilot.com
EMAIL_FROM_NAME=ProxiPilot
EMAIL_REPLY_TO=hello@proxipilot.com
